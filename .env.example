# Copy to .env.local and fill in. Never commit .env.local.
#
# Both env modules name this file when they refuse to load:
#   "Copy .env.example to .env.local and fill it in."
# It had been deleted, so that instruction pointed at nothing and a new
# contributor's first run failed with a list of variables and no template.
#
# Every value below is a placeholder describing the required SHAPE. The Zod
# schemas in src/lib/env.ts and src/lib/env.public.ts are the authority; where a
# format is checked rather than just presence, it is noted.

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL is the Supavisor **transaction** pooler on :6543 and must
# connect as `app_runtime`, which has no BYPASSRLS. Pointing it at `postgres`
# silently disables all 85 row-level policies while the site keeps working —
# a configuration that fails open and looks healthy.
DATABASE_URL=postgresql://app_runtime.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# DIRECT_URL is **session** mode on :5432, connects as the owner, and is for
# DDL only: drizzle-kit, migrations, seeds and scripts/assert-rls.ts.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Supabase (auth and storage only — never data access) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ── Email ────────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_GENERAL=
MAIL_TO_PARTNERSHIP=
MAIL_TO_HR=
# Receives confidential complaints. Route it to the safeguarding focal point,
# not to a shared inbox.
MAIL_TO_SENSITIVE=

# ── Anti-abuse ───────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Privacy ──────────────────────────────────────────────────────────────
# At least 32 characters — the length is checked, because a short salt is a
# broken salt. Generate with: openssl rand -base64 48
IP_HASH_SALT=

# Exactly 64 hex characters (32 bytes) for AES-256-GCM of sensitive submission
# payloads. Required, not optional: app.submit_form() rejects an unencrypted
# sensitive payload with PCSRD_SENSITIVE_PLAINTEXT.
# Generate with: openssl rand -hex 32
SUBMISSION_ENC_KEY=

# Names the key that produced a ciphertext, so keys can be rotated.
SUBMISSION_ENC_KEY_ID=k1

# ── Ops ──────────────────────────────────────────────────────────────────
# At least 16 characters. Both cron routes compare against it.
CRON_SECRET=

# ── Error monitoring (optional) ──────────────────────────────────────────
# Leave all three empty to run without Sentry: the SDK never initialises, the
# CSP names no ingest origin, and the build never contacts Sentry.
#
# SENTRY_DSN is the server-side DSN; NEXT_PUBLIC_SENTRY_DSN the browser's. They
# are usually the same value. A DSN is a public write-only key, not a secret,
# but the CSP derives its connect-src entry from it, so it must be https.
# Scrubbing is in sentry.scrub.config.ts: no user, no headers, no cookies, no
# bodies, no query strings, no replay, no tracing — a message and a stack.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only. When set, `next build` uploads source maps to Sentry (and
# needs SENTRY_ORG and SENTRY_PROJECT). When unset, no upload is attempted. CI
# does not set it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Public (inlined into the client bundle — nothing secret here) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://example.org
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Digits only, no leading `+` — this is the wa.me path format.
NEXT_PUBLIC_WHATSAPP_NUMBER=
