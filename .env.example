# PCSRD — copy this file to `.env.local` and fill every <placeholder>.
# `.env.local` is git-ignored. Never commit real values.
#
# Where to get each value is noted inline. Two of them you can generate
# yourself right now with:  openssl rand -hex 32

# ── Database ────────────────────────────────────────────────────────────
# Supavisor TRANSACTION mode, port 6543 — used by the app at runtime.
# postgres-js MUST be created with { prepare: false } against this URL.
DATABASE_URL="postgresql://postgres.ouyivpcvowkpcfiqduyx:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"
# Supavisor SESSION mode, port 5432 — migrations, seed, drizzle-studio.
# The pooler cannot run session-level DDL, so this is not optional.
DIRECT_URL="postgresql://postgres.ouyivpcvowkpcfiqduyx:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
# ↑ Supabase Dashboard → Settings → Database → Database password

# ── Supabase (auth + storage ONLY — never for data access, see 00-ARCHITECTURE D1)
NEXT_PUBLIC_SUPABASE_URL="https://ouyivpcvowkpcfiqduyx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key>"   # SERVER ONLY. Never NEXT_PUBLIC_.
# ↑ Supabase Dashboard → Settings → API Keys

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY="<resend api key>"
MAIL_FROM="PCSRD <noreply@example.org>"
MAIL_TO_GENERAL="<inbox for general enquiries>"
MAIL_TO_PARTNERSHIP="<inbox for partnership inquiries>"
MAIL_TO_HR="<inbox for job applications>"
MAIL_TO_SENSITIVE="<restricted inbox for complaints>"
# ↑ MAIL_TO_SENSITIVE is a policy decision about who may read confidential
#   complaints, not a config value. Confirm it with the organisation.

# ── Anti-abuse ──────────────────────────────────────────────────────────
# These two are Cloudflare's PUBLISHED always-pass test keys. They let the
# Turnstile code path work end to end with no Cloudflare account. Replace
# both before production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

UPSTASH_REDIS_REST_URL="<upstash redis rest url>"
UPSTASH_REDIS_REST_TOKEN="<upstash redis rest token>"
# ↑ upstash.com → free tier is far beyond this project's traffic

# ── Privacy ─────────────────────────────────────────────────────────────
# Raw IPs are never stored. Submissions store sha256(ip + this salt), and
# NULL for confidential complaints.  Generate: openssl rand -hex 32
IP_HASH_SALT="<32-byte random hex>"

# ── Ops ─────────────────────────────────────────────────────────────────
# Guards /api/cron/*.  Generate: openssl rand -hex 32
CRON_SECRET="<32-byte random hex>"
SENTRY_DSN=""
NEXT_PUBLIC_ANALYTICS_URL=""
NEXT_PUBLIC_ANALYTICS_SITE_ID=""

# ── Contact ─────────────────────────────────────────────────────────────
# Digits only, no leading + — this is the wa.me link format.
NEXT_PUBLIC_WHATSAPP_NUMBER="970595889697"

# ── Dev / CI switches ───────────────────────────────────────────────────
SEED_FIXTURES="1"        # 1 = insert dev fixtures in scripts/seed.ts
SKIP_ENV_VALIDATION=""   # set to 1 for CI builds that have no secrets
